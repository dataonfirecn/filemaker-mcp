# local | production | prod —— 设为 production/prod 时，启动会强制校验下方密钥配置
APP_ENV=local
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
AUDIT_DATABASE_URL=postgresql://starrc:starrc@localhost:5432/starrc_audit

FILEMAKER_HOST=https://your-filemaker-server.example.com
FILEMAKER_DATABASE=YourDatabaseName
FILEMAKER_USERNAME=api_user
FILEMAKER_PASSWORD=change-me
FILEMAKER_API_VERSION=v2
# 仅控制 FileMaker（自托管，可能自签证书）的 TLS 校验，不影响 LLM
FILEMAKER_SSL_VERIFY=false
FILEMAKER_TOKEN_INACTIVITY_TIMEOUT_SECONDS=900
FILEMAKER_READ_ONLY=true
# 仅开放“内部订单 Web 合并”的专用 Data API 写通道；通用写接口仍受上面的只读开关保护。
# 启用前，创建布局必须暴露日期/订单类型/分类，读取布局必须暴露订单 ID/客户 ID，明细布局必须暴露订单 ID/产品/数量。
FILEMAKER_WEB_MERGE_ENABLED=false
FILEMAKER_WEB_MERGE_ORDER_LAYOUT=@出貨單
FILEMAKER_WEB_MERGE_ORDER_CREATE_LAYOUT=訂單 資料_業務_EDIT
FILEMAKER_WEB_MERGE_ITEM_LAYOUT=出貨單資料_List_業務
FILEMAKER_WEB_MERGE_ORDER_DATE_FIELD=日期
FILEMAKER_WEB_MERGE_DATE_FORMAT=%m/%d/%Y
FILEMAKER_WEB_MERGE_ORDER_TYPE_FIELD=訂單型態
FILEMAKER_WEB_MERGE_ORDER_TYPE_VALUE=零件包
FILEMAKER_WEB_MERGE_ORDER_CATEGORY_FIELD=訂單分類
FILEMAKER_WEB_MERGE_ORDER_CATEGORY_VALUE=合併單
FILEMAKER_WEB_MERGE_MAX_ORDERS=200
FILEMAKER_WEB_MERGE_MAX_ITEMS=2000
# 仅开放“订单 BOM 计算单”的专用 Data API 写通道；通用写接口仍保持只读。
# web_BOM计算 布局只需暴露“出貨單 ID”和“ID_BOM計算”两个字段。
FILEMAKER_BOM_WRITE_ENABLED=false
FILEMAKER_BOM_ORDER_READ_LAYOUT=訂單 發料單
FILEMAKER_BOM_ORDER_WRITE_LAYOUT=web_BOM计算
FILEMAKER_BOM_ORDER_ITEM_LAYOUT=出貨單資料_List_業務
FILEMAKER_BOM_ORDER_RICH_ITEM_LAYOUT=@出貨單資料
FILEMAKER_BOM_HEADER_LAYOUT=訂單 計算單_精簡
FILEMAKER_BOM_DETAIL_LAYOUT=@BOM计算单资料
FILEMAKER_BOM_NONREPEAT_LAYOUT=@BOM計算單資料Non
FILEMAKER_BOM_PRODUCT_LAYOUT=@product_bom
FILEMAKER_BOM_PART_LAYOUT=零件 資料_業務
FILEMAKER_BOM_MAX_DETAIL_RECORDS=1000
FILEMAKER_ODATA_ENABLED=true
FILEMAKER_ODATA_VERSION=v4
FILEMAKER_ODATA_AUTH_MODE=basic
FILEMAKER_ODATA_FMID_TOKEN=
FILEMAKER_ODATA_MAX_TOP=10
SEMANTIC_MAPPING_PATH=backend/config/semantic_mapping.json
WEBVIEWER_PRIVILEGE_SET_POLICY_PATH=backend/config/webviewer_privilege_sets.json

NATURAL_QUERY_TIMEZONE=Asia/Shanghai
NATURAL_QUERY_FILEMAKER_DATE_FORMAT=%Y/%m/%d
NATURAL_QUERY_FILEMAKER_TIMESTAMP_FORMAT=%Y/%m/%d %H:%M:%S
NATURAL_QUERY_PRODUCT_CREATED_FIELDS=创建日期,創建日期,建立日期,新增日期,创建时间,創建時間,建立時間,createdAt,RecordCreatedAt
NATURAL_QUERY_USE_RAG=true
NATURAL_QUERY_USE_CACHED_RECORDS=false
NATURAL_QUERY_RAG_HIT_LIMIT=10
NATURAL_QUERY_MAX_DISPLAY_ROWS=10
NATURAL_QUERY_LLM_ENABLED=false
NATURAL_QUERY_ANALYTICS_LLM_ENABLED=true
NATURAL_QUERY_ANALYTICS_PENDING_LIMIT=100
NATURAL_QUERY_ANALYTICS_WORKER_ENABLED=false
NATURAL_QUERY_ANALYTICS_POLL_INTERVAL_SECONDS=60
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=12
LLM_MAX_OUTPUT_TOKENS=320
# 独立控制 LLM（访问公网 HTTPS，如 api.deepseek.com）的 TLS 校验；生产环境应保持 true
LLM_SSL_VERIFY=true

RAG_INDEX_ENABLED=true
RAG_DATABASE_PATH=backend/data/rag_index.db
RAG_INDEX_REFRESH_ON_STARTUP=false
RAG_INDEX_STARTUP_DELAY_SECONDS=20
RAG_INDEX_REFRESH_INTERVAL_SECONDS=21600
RAG_INDEX_REFRESH_SCHEDULE_TIME=00:00
RAG_INDEX_REFRESH_SCHEDULE_TIMEZONE=Asia/Shanghai
RAG_INDEX_LAYOUT_PREFIX=@
RAG_INDEX_LAYOUT_INCLUDE=@products,@零件
RAG_INDEX_LAYOUT_EXCLUDE=
RAG_INDEX_MAX_LAYOUTS=0
RAG_INDEX_READ_LAYOUT_FIELDS=true
RAG_INDEX_LAYOUT_FIELDS_TIMEOUT_SECONDS=8
RAG_INDEX_PAGE_SIZE=500
RAG_INDEX_MAX_RECORDS_PER_LAYOUT=5000
RAG_INDEX_MAX_FIELDS_PER_RECORD=40
RAG_INDEX_VALUE_MAX_LENGTH=160
RAG_INDEX_SEMANTIC_PROFILE_ENABLED=true
RAG_INDEX_SEMANTIC_PROFILE_LAYOUTS=@products,@零件
RAG_INDEX_SEMANTIC_SAMPLE_RECORDS=200
RAG_INDEX_SEMANTIC_LLM_TIMEOUT_SECONDS=30
RAG_INDEX_SEMANTIC_LLM_MAX_OUTPUT_TOKENS=3600

# 生产环境（APP_ENV=production/prod）必填：会话 token 的 HMAC 签名密钥，请用强随机值（如 openssl rand -hex 32）
WEBVIEWER_CONTEXT_SECRET=change-me
# 生产环境必须为 false，否则未认证请求可签发会话 token
WEBVIEWER_ALLOW_MOCK_CONTEXT=true
WEBVIEWER_SESSION_TTL_SECONDS=28800
# 线上供远程同事直接登录；密码仅保存 PBKDF2 哈希，不要填写明文。
# privilegeSet 必须与 FileMaker“安全性”中的权限集名称一致；省略时使用 internal_remote。
WEBVIEWER_REMOTE_ACCESS_ENABLED=false
WEBVIEWER_REMOTE_ACCOUNTS_JSON='[{"username":"admin","displayName":"StarRC 管理员","privilegeSet":"[Full Access]","passwordHash":"pbkdf2_sha256$..."}]'
WEBVIEWER_REMOTE_LOGIN_MAX_ATTEMPTS=5
WEBVIEWER_REMOTE_LOGIN_WINDOW_SECONDS=900

# 外部客户查询页（/customer-chat）。启用后账号必须精确绑定 FileMaker 的 Client 值；仅开放已审核产品基础清单与实时库存。
CUSTOMER_CHAT_ENABLED=false
# 启用时必填，至少 32 字符；建议：openssl rand -hex 32
CUSTOMER_CHAT_TOKEN_SECRET=
CUSTOMER_CHAT_SESSION_TTL_SECONDS=7200
CUSTOMER_CHAT_LOGIN_MAX_ATTEMPTS=5
CUSTOMER_CHAT_LOGIN_WINDOW_SECONDS=900
# 密码哈希生成：cd backend && python -m scripts.hash_customer_password
# 单行 JSON 示例：[{"username":"acme","displayName":"ACME 客户","clientName":"ACME","passwordHash":"pbkdf2_sha256$..."}]
CUSTOMER_CHAT_ACCOUNTS_JSON='[]'
CUSTOMER_PORTAL_PUBLIC_URL=https://mayakofm.dataonfire.cn/customer-chat
# 可选：配置后，管理员可以把用户名和临时密码直接发送到客户邮箱；
# 同时账号管理页面也能把 admin 后台登录信息（.env 中的 FILEMAKER 账号）下发到指定邮箱。
CUSTOMER_SMTP_HOST=
CUSTOMER_SMTP_PORT=587
CUSTOMER_SMTP_USERNAME=
CUSTOMER_SMTP_PASSWORD=
CUSTOMER_SMTP_FROM_EMAIL=
CUSTOMER_SMTP_FROM_NAME=MayakoFM Customer Portal
CUSTOMER_SMTP_STARTTLS=true
CUSTOMER_SMTP_SSL=false
CUSTOMER_SMTP_TIMEOUT_SECONDS=15

# 生产环境（APP_ENV=production/prod）必填，否则启动失败
MES_CALLBACK_API_KEY=
MES_HMAC_SECRET=
MES_FILEMAKER_LAYOUT=
MES_FILEMAKER_SCRIPT_NAME=MES_UpdateWorkOrder
CALLBACK_MAX_ATTEMPTS=8

# iPad/iPhone 到货照片：后端签发短时 URL，客户端直传腾讯云 COS。
# SecretId/SecretKey 只配置在服务器 .env，不得写入 iOS 或 Web 前端。
COS_ENABLED=false
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=starrc-1252872963
COS_REGION=ap-guangzhou
COS_UPLOAD_BASE_URL=https://starrc-1252872963.cos.ap-guangzhou.myqcloud.com
# 当前自定义域名证书绑定完成后用于展示；签名上传暂时使用上面的官方域名。
COS_PUBLIC_BASE_URL=https://oss.dataonfire.cn
COS_PRESIGN_TTL_SECONDS=600
COS_MAX_UPLOAD_BYTES=10485760
COS_MAX_ATTACHMENTS_PER_RECEIPT=8
COS_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif

# 零件附件拆表：只有完成 PartAssets 表和 Data API 布局安装后才开启。
FILEMAKER_PART_ASSETS_ENABLED=false
FILEMAKER_PART_ASSET_LAYOUT=PartAssets

QR_BASE_URL=http://localhost:8080/q
