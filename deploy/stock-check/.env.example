STOCK_CHECK_BACKEND_IMAGE=stock-check-backend:latest
STOCK_CHECK_FRONTEND_IMAGE=stock-check-frontend:latest
STOCK_CHECK_POSTGRES_DB=stock_check
STOCK_CHECK_POSTGRES_USER=stock_check
STOCK_CHECK_POSTGRES_PASSWORD=replace-with-random-hex
STOCK_CHECK_POSTGRES_VOLUME=stock-check-postgres-data
STOCK_CHECK_BACKEND_VOLUME=stock-check-backend-data

FILEMAKER_HOST=https://filemaker.example.com
FILEMAKER_DATABASE=DB
FILEMAKER_USERNAME=readonly-user
FILEMAKER_PASSWORD=replace-me
FILEMAKER_API_VERSION=v2
FILEMAKER_SSL_VERIFY=false
FILEMAKER_TOKEN_INACTIVITY_TIMEOUT_SECONDS=900

WEBVIEWER_CONTEXT_SECRET=replace-with-random-hex
MES_CALLBACK_API_KEY=replace-with-random-hex
MES_HMAC_SECRET=replace-with-random-hex

CUSTOMER_CHAT_TOKEN_SECRET=replace-with-random-hex
CUSTOMER_CHAT_SESSION_TTL_SECONDS=7200
CUSTOMER_CHAT_LOGIN_MAX_ATTEMPTS=5
CUSTOMER_CHAT_LOGIN_WINDOW_SECONDS=900
CUSTOMER_CHAT_ACCOUNTS_JSON='[{"username":"admin","displayName":"Stock Check Administrator","email":"admin@example.com","clientName":"Customer Name","productPrivilege":"customer-web-code","partCustomerId":"catalog-customer-id","canViewPrice":true,"isAdmin":true,"passwordHash":"pbkdf2_sha256$..."}]'
CUSTOMER_PORTAL_PUBLIC_URL=https://stockcheck.net/customer-chat
CUSTOMER_SMTP_HOST=
CUSTOMER_SMTP_PORT=587
CUSTOMER_SMTP_USERNAME=
CUSTOMER_SMTP_PASSWORD=
CUSTOMER_SMTP_FROM_EMAIL=
CUSTOMER_SMTP_FROM_NAME=Stock Check
CUSTOMER_SMTP_STARTTLS=true
CUSTOMER_SMTP_SSL=false
CUSTOMER_SMTP_TIMEOUT_SECONDS=15
